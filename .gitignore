# ==========================================
# Monorepo Stockcomerce (.gitignore raiz)
# ==========================================

# --- Backend (Java / Spring Boot / Maven) ---
backend/target/
backend/build/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear
hs_err_pid*

# --- Frontend (Angular / Node.js) ---
node_modules/
**/node_modules/
frontend/dist/
frontend/.angular/
frontend/tmp/
frontend/out-tsc/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Variables de entorno y secretos locales ---
.env
.env.local
.env.*.local

# --- IDEs y editores ---
.idea/
*.iws
*.iml
*.ipr
.project
.classpath
.settings/
.factorypath
.springBeans
.sts4-cache
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini
